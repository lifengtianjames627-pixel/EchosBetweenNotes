{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "Sorted pair of two emails joined by '|'"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string",
      "description": "URL of an attached image or PDF"
    },
    "attachment_name": {
      "type": "string",
      "description": "Original file name of the attachment"
    },
    "attachment_kind": {
      "type": "string",
      "enum": [
        "image",
        "pdf",
        "file"
      ],
      "description": "How the attachment should be rendered"
    }
  },
  "required": [
    "chat_id",
    "sender_email",
    "content"
  ]
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "equipped_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to 4 equipped badge IDs shown on reviews and profile"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Uploaded profile picture URL (stored file)"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "minor",
        "adult"
      ],
      "description": "Self-declared age bracket. Band-forming posts are only visible within the same bracket so adults and minors never match with each other."
    },
    "total_browsing_minutes": {
      "type": "number",
      "default": 0
    },
    "daily_minutes": {
      "type": "number",
      "default": 0
    },
    "daily_minutes_date": {
      "type": "string"
    },
    "weekly_minutes": {
      "type": "number",
      "default": 0
    },
    "weekly_minutes_week": {
      "type": "string"
    },
    "monthly_minutes": {
      "type": "number",
      "default": 0
    },
    "monthly_minutes_month": {
      "type": "string"
    }
  },
  "required": [
    "equipped_badges",
    "daily_minutes_date",
    "weekly_minutes_week",
    "monthly_minutes_month"
  ]
}
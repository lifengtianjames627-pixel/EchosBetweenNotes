{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Member-chosen display name. Shown across the app in place of the platform full_name when set."
    },
    "equipped_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to 4 equipped badge IDs shown on reviews and profile"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Uploaded profile picture URL (stored file)"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "minor",
        "adult"
      ],
      "description": "Self-declared age bracket. Band-forming posts are only visible within the same bracket so adults and minors never match with each other."
    },
    "music_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Music styles selected during profile setup"
    },
    "biography": {
      "type": "string",
      "description": "Short member biography"
    },
    "location_network_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the member allows network-based nearby discovery"
    },
    "has_band": {
      "type": "boolean",
      "default": false,
      "description": "Whether the member is currently in a band"
    },
    "band_name": {
      "type": "string",
      "description": "Current band name when applicable"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the first-time profile setup was completed"
    },
    "total_browsing_minutes": {
      "type": "number",
      "default": 0
    },
    "daily_minutes": {
      "type": "number",
      "default": 0
    },
    "daily_minutes_date": {
      "type": "string"
    },
    "weekly_minutes": {
      "type": "number",
      "default": 0
    },
    "weekly_minutes_week": {
      "type": "string"
    },
    "monthly_minutes": {
      "type": "number",
      "default": 0
    },
    "monthly_minutes_month": {
      "type": "string"
    },
    "messages_last_seen": {
      "type": "object",
      "description": "Per-peer last-seen map { peerEmail: ISOString }. A conversation's unread count is messages from that peer after their timestamp. (Legacy: a single ISO string = global last-seen, still honoured.)"
    }
  },
  "required": [
    "equipped_badges",
    "daily_minutes_date",
    "weekly_minutes_week",
    "monthly_minutes_month"
  ]
}
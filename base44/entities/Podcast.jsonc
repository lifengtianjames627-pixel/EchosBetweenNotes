{
  "name": "Podcast",
  "type": "object",
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Episode title"
    },
    "host_name": {
      "type": "string",
      "description": "Host or creator name"
    },
    "host_email": {
      "type": "string",
      "description": "Host identity for existing in-app contact"
    },
    "category": {
      "type": "string",
      "enum": [
        "youth_ears_lab",
        "sonic_technical_breakdown",
        "cross_cultural_sound",
        "live_scene_chronicle",
        "independent_creator",
        "behind_the_lyrics"
      ]
    },
    "description": {
      "type": "string",
      "description": "Episode summary"
    },
    "cover_url": {
      "type": "string",
      "description": "Legacy episode artwork URL; new covers are uploaded privately"
    },
    "has_uploaded_cover": {
      "type": "boolean",
      "default": false,
      "description": "Artwork lives in the referenced private audio asset; shared metadata contains no file URI"
    },
    "audio_url": {
      "type": "string",
      "description": "Legacy audio URL; new uploads never populate this field"
    },
    "audio_asset_id": {
      "type": "string",
      "description": "Private PodcastAudioAsset reference, not a storage URI or signed link"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Episode duration in minutes"
    }
  },
  "required": [
    "title",
    "host_name",
    "category"
  ]
}
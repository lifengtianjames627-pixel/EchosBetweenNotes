{
  "name": "PodcastAudioAsset",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "storage_provider": {
      "type": "string",
      "enum": [
        "base44",
        "r2"
      ],
      "default": "base44"
    },
    "r2_object_key": {
      "type": "string",
      "description": "Private R2 object identifier; returned to neither shared episode metadata nor public clients"
    },
    "cover_file_uri": {
      "type": "string",
      "description": "Optional private artwork attached to this episode audio asset; never copied to the shared Podcast record"
    },
    "cover_file_name": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "file_uri",
    "file_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
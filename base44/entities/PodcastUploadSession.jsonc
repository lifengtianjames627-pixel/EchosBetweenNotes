{
  "name": "PodcastUploadSession",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "object_key": {
      "type": "string"
    },
    "upload_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "content_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploading",
        "completed",
        "published",
        "aborted"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "podcast_id": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "object_key",
    "upload_id",
    "file_name",
    "size_bytes",
    "content_type",
    "status",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
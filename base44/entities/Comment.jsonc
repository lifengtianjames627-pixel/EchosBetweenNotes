{
  "name": "Comment",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "description": "ID of the review being commented on"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the commenter"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the commenter"
    }
  },
  "required": [
    "review_id",
    "content"
  ]
}
{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "from_email": {
      "type": "string",
      "description": "Sender email"
    },
    "from_name": {
      "type": "string",
      "description": "Sender name"
    },
    "to_email": {
      "type": "string",
      "description": "Recipient email"
    },
    "to_name": {
      "type": "string",
      "description": "Recipient name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "message": {
      "type": "string",
      "description": "Optional message with request"
    }
  },
  "required": [
    "from_email",
    "to_email"
  ]
}
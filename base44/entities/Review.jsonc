{
  "name": "Review",
  "type": "object",
  "properties": {
    "album_id": {
      "type": "string",
      "description": "ID of the album being reviewed"
    },
    "album_title": {
      "type": "string",
      "description": "Album title for display"
    },
    "album_artist": {
      "type": "string",
      "description": "Album artist for display"
    },
    "album_cover_url": {
      "type": "string",
      "description": "Album cover for display"
    },
    "rating": {
      "type": "number",
      "description": "Rating from 1 to 5"
    },
    "title": {
      "type": "string",
      "description": "Review title"
    },
    "content": {
      "type": "string",
      "description": "Review text"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of the reviewer (for subscriptions)"
    },
    "likes_count": {
      "type": "number",
      "description": "Number of likes",
      "default": 0
    },
    "dislikes_count": {
      "type": "number",
      "description": "Number of dislikes",
      "default": 0
    },
    "band_style": {
      "type": "string",
      "description": "Specific sub-style or sub-genre of the band"
    },
    "band_background": {
      "type": "string",
      "description": "Background information about the band/artist"
    },
    "band_history": {
      "type": "string",
      "description": "History of the band/artist"
    },
    "band_story": {
      "type": "string",
      "description": "The background story behind the band/artist"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending_review",
        "blocked"
      ],
      "default": "approved",
      "description": "AI moderation status"
    },
    "moderation_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Flagged categories from AI moderation"
    },
    "moderation_reason": {
      "type": "string",
      "description": "AI explanation for flagging"
    },
    "moderation_confidence": {
      "type": "number",
      "description": "AI confidence score 0.0-1.0"
    }
  },
  "required": [
    "album_id",
    "rating",
    "content"
  ]
}
{
  "name": "Review",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.moderation_status": {
            "$nin": [
              "pending_review",
              "blocked"
            ]
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "album_id": {
      "type": "string",
      "description": "ID of the album being reviewed"
    },
    "album_title": {
      "type": "string",
      "description": "Album title for display"
    },
    "album_artist": {
      "type": "string",
      "description": "Album artist for display"
    },
    "album_cover_url": {
      "type": "string",
      "description": "Album cover for display"
    },
    "rating": {
      "type": "number",
      "description": "Rating from 1 to 5"
    },
    "title": {
      "type": "string",
      "description": "Review title"
    },
    "content": {
      "type": "string",
      "description": "Review text"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "reviewer_equipped_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reviewer's equipped badge IDs at time of posting"
    },
    "likes_count": {
      "type": "number",
      "description": "Number of likes",
      "default": 0
    },
    "dislikes_count": {
      "type": "number",
      "description": "Number of dislikes",
      "default": 0
    },
    "band_style": {
      "type": "string"
    },
    "band_background": {
      "type": "string"
    },
    "band_history": {
      "type": "string"
    },
    "band_story": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending_review",
        "blocked"
      ],
      "default": "approved"
    },
    "moderation_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moderation_reason": {
      "type": "string"
    },
    "moderation_confidence": {
      "type": "number"
    }
  },
  "required": [
    "album_id",
    "rating",
    "content"
  ]
}